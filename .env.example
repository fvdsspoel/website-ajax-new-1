# ── Ajax Trading Corporation website ─────────────────────────────
# Copy to .env and fill in. See DEPLOY_CJ.md for every step.

APP_NAME="Ajax Trading Corporation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Test site first, then the real domain on go-live day:
APP_URL=https://new.ajaxtradingcorp.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# true while testing on the temporary address (stops Google indexing it)
SITE_NOINDEX=true

LOG_CHANNEL=single
LOG_LEVEL=warning

# cPanel → MySQL Databases (new database, not the CRM's)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=240
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ── CRM connection ──
# Quote form + kitchen builder leads → CRM Inquiries (public endpoint, no key needed)
CRM_INQUIRY_API_URL=https://crm-sales.ajaxtradingcorp.com/api/inquiry
CRM_INQUIRY_API_KEY=
# Live chat with Maya → CRM. Key must be EXACTLY the CRM's WEBCHAT_API_KEY.
CRM_WEBCHAT_URL=https://crm-sales.ajaxtradingcorp.com/api/webchat
CRM_WEBCHAT_API_KEY=


# ── Company details ──
COMPANY_PHONE_PRIMARY="0994 364 8582"
COMPANY_PHONE_SECONDARY="0992 149 6385"
COMPANY_PHONES_MORE="0953 769 8630, 0962 477 0818, 0934 620 1976"
COMPANY_ADDRESS="281 Purok 6, Santisimo Road, Brgy. Soledad, San Pablo City, Laguna"
COMPANY_EMAIL=ajaxtradingcorp2024@gmail.com
COMPANY_MESSENGER_URL=https://m.me/61559238760421

# First admin login for /admin (remove both lines after running AdminUserSeeder)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ── Facebook & Google (optional — leave empty until marketing gives the IDs) ──
# Facebook page shown on the homepage feed (and the Facebook link everywhere)
COMPANY_FACEBOOK_PAGE=https://www.facebook.com/profile.php?id=61559238760421
# Meta Pixel ID (Facebook ads: counts quote requests as "Lead")
META_PIXEL_ID=
# Google Analytics 4 measurement ID (G-XXXXXXX)
GA4_MEASUREMENT_ID=
